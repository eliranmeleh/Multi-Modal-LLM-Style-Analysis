# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Only the key for the configured provider (llm.provider) is required.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Set to 1 only when deliberately running tests against a real provider.
# CI never sets this, and no test should need it.
MMLSA_ALLOW_LIVE=0
